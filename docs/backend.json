
{
  "entities": {
    "Restaurant": {
      "title": "Restaurant",
      "description": "A food establishment in the Karbi Anglong area.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "cuisine": { "type": "string" },
        "rating": { "type": "number" },
        "deliveryTime": { "type": "string" },
        "image": { "type": "string" },
        "priceRange": { "type": "string" },
        "priceForTwo": { "type": "number" }
      },
      "required": ["name", "cuisine", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "A food delivery order placed by a user.",
      "type": "object",
      "properties": {
        "restaurantName": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Preparing", "Out for delivery", "Delivered"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "items": { "type": "array" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Pending"] }
      },
      "required": ["restaurantName", "total", "status", "createdAt", "paymentMethod", "paymentStatus"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Information about the authenticated user.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "address": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "walletBalance": { "type": "number", "description": "The current balance for food and withdrawals." },
        "wingoBalance": { "type": "number", "description": "The current balance for Wingo games." },
        "lastLogin": { "type": "object" }
      }
    },
    "WithdrawalRequest": {
      "title": "Withdrawal Request",
      "description": "A request by a user to withdraw wallet balance to their bank via UPI.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "amount": { "type": "number" },
        "upiId": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Completed", "Rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "upiId", "status", "createdAt"]
    },
    "WingoConfig": {
      "title": "Wingo Config",
      "description": "Admin controlled results for Wingo periods.",
      "type": "object",
      "properties": {
        "periodId": { "type": "string" },
        "number": { "type": "number" }
      },
      "required": ["periodId", "number"]
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/restaurants/{restaurantId}": {
      "schema": "#/backend/entities/Restaurant",
      "description": "Global collection of restaurants."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": "#/backend/entities/Order",
      "description": "User-specific order history."
    },
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "User profile data."
    },
    "/withdrawalRequests/{requestId}": {
      "schema": "#/backend/entities/WithdrawalRequest",
      "description": "Global collection of withdrawal requests for admin review."
    },
    "/wingoConfig/{configId}": {
      "schema": "#/backend/entities/WingoConfig",
      "description": "Admin controlled Wingo results."
    }
  }
}
