
{
  "entities": {
    "Restaurant": {
      "title": "Restaurant",
      "description": "A food establishment in the Karbi Anglong area.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "cuisine": { "type": "string" },
        "rating": { "type": "number" },
        "deliveryTime": { "type": "string" },
        "image": { "type": "string" },
        "priceRange": { "type": "string" },
        "priceForTwo": { "type": "number" }
      },
      "required": ["name", "cuisine", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "A food delivery order placed by a user.",
      "type": "object",
      "properties": {
        "restaurantName": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Preparing", "Out for delivery", "Delivered"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "items": { "type": "array" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string", "enum": ["Paid", "Pending"] }
      },
      "required": ["restaurantName", "total", "status", "createdAt", "paymentMethod", "paymentStatus"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Information about the authenticated user.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "address": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "walletBalance": { "type": "number", "description": "The current balance of Karbi Coins." },
        "lastLogin": { "type": "object" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/restaurants/{restaurantId}": {
      "schema": "#/backend/entities/Restaurant",
      "description": "Global collection of restaurants."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": "#/backend/entities/Order",
      "description": "User-specific order history."
    },
    "/users/{userId}": {
      "schema": "#/backend/entities/UserProfile",
      "description": "User profile data."
    }
  }
}
